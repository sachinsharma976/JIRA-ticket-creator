# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
# SQLite file, relative to the project root.
DATABASE_URL="file:./dev.db"

# --- Jira Cloud ---
# Your Jira site, e.g. https://your-domain.atlassian.net (no trailing slash)
JIRA_BASE_URL="https://your-domain.atlassian.net"
# The email address of the Jira account that owns the API token below
JIRA_EMAIL="you@example.com"
# Create at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN="your-api-token"
# The project key tickets will be created in, e.g. "PROJ"
JIRA_PROJECT_KEY="PROJ"
# The numeric board ID whose active sprint tickets should be created into.
# Find it in the board URL: .../jira/software/projects/PROJ/boards/<BOARD_ID>
JIRA_BOARD_ID="1"
# Must exactly match an issue type name configured on JIRA_PROJECT_KEY (e.g. Task, Story, Bug)
JIRA_DEFAULT_ISSUE_TYPE="Task"

# --- AI generation (Google Gemini, free tier) ---
# Create at https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key"

# --- Rate limiting ---
# Max tickets that can be CREATED in Jira per UTC calendar day. Drafting is unlimited.
DAILY_TICKET_LIMIT="10"
